NEXUSPILOT_ENVIRONMENT=development
# Production deployment files/credentials are generated by deployments/production/initialize.py.
# Non-development mode refuses example/short service secrets and missing DB passwords.
NEXUSPILOT_API_KEY=replace-with-a-long-random-value
NEXUSPILOT_INTERNAL_API_KEY=replace-with-a-separate-internal-random-value
# Optional private App credentials and static read operation paths; disabled by default.
# Never expose this value to the browser or commit real credentials.
# Setup and credential pairing: docs/implementation/personal-assistant-app-integration.md
NEXUSPILOT_APP_TOOLS_JSON={}
# Optional login_redirect_uris per configured App enables exact SSO callback allowlisting.
# Default [] disables App login. Use HTTPS except explicit loopback development callbacks.
# App credentials remain private; never copy this configuration into frontend environment files.
# Native Agent only. Private approved read-only MCP connections; see Phase 7 setup.
# No connection is enabled by default. Never put tokens in browser configuration.
NEXUSPILOT_MCP_CONNECTIONS_JSON={}
# Email enrollment stays disabled. Generate a dedicated Fernet key privately before enabling.
# Never reuse a Provider key or print the verification key/code in logs.
NEXUSPILOT_REGISTRATION_ENABLED=false
NEXUSPILOT_PASSWORD_RESET_ENABLED=false
# Password reset is independent of registration; reuse the private verification key and SMTP below.
# NEXUSPILOT_REGISTRATION_VERIFICATION_KEY=<private-Fernet-key>
NEXUSPILOT_REGISTRATION_SMTP_HOST=
NEXUSPILOT_REGISTRATION_SMTP_PORT=587
NEXUSPILOT_REGISTRATION_SMTP_SENDER=
NEXUSPILOT_REGISTRATION_SMTP_USERNAME=
# NEXUSPILOT_REGISTRATION_SMTP_PASSWORD=<private-relay-password>
NEXUSPILOT_REGISTRATION_SMTP_STARTTLS=true
# Native web tools require an explicit owner list. Search: DeepSeek then Tavily; Fetch: local then Tavily.
# Do not put credentials in browser env files. Comma-separated exact user IDs; App Runs excluded.
NEXUSPILOT_WEB_SEARCH_API_KEY=
NEXUSPILOT_TAVILY_API_KEY=
NEXUSPILOT_WEB_TOOL_ALLOWED_USER_IDS=
NEXUSPILOT_CURSOR_SIGNING_KEY=replace-with-a-separate-long-random-value
NEXUSPILOT_PROVIDER_CONTINUATION_ENCRYPTION_KEY=replace-with-a-dedicated-long-encryption-value
NEXUSPILOT_PROVIDER_CONTINUATION_RETENTION_SECONDS=86400
# Browser authentication uses opaque Cookie sessions stored only as database digests.
# Production must set COOKIE_SECURE=true and use only HTTPS origins.
# Login is opt-in for local use; production refuses to start with it disabled.
NEXUSPILOT_AUTHENTICATION_ENABLED=false
NEXUSPILOT_AUTHENTICATION_COOKIE_SECURE=false
NEXUSPILOT_AUTHENTICATION_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXUSPILOT_AUTHENTICATION_SESSION_IDLE_SECONDS=43200
NEXUSPILOT_AUTHENTICATION_SESSION_ABSOLUTE_SECONDS=2592000
NEXUSPILOT_AUTHENTICATION_LOGIN_FAILURE_LIMIT=5
NEXUSPILOT_AUTHENTICATION_LOGIN_FAILURE_WINDOW_SECONDS=900
NEXUSPILOT_DATABASE_URL=mysql+aiomysql://nexuspilot:nexuspilot@localhost:3306/nexuspilot
NEXUSPILOT_MINIO_ENDPOINT=localhost:9000
NEXUSPILOT_MINIO_ACCESS_KEY=nexuspilot
NEXUSPILOT_MINIO_SECRET_KEY=local-development-secret-change-me
NEXUSPILOT_MINIO_BUCKET=nexuspilot-artifacts
NEXUSPILOT_MINIO_SECURE=false
# Product memory: independent private 32-byte URL-safe Base64 encryption key.
# Keep the same value on API and Worker; back it up separately from object data.
# Leave empty only when memory storage is intentionally unavailable (returns an error,
# never stores plaintext). No default secret; do not commit a generated value.
NEXUSPILOT_MEMORY_ENCRYPTION_KEY=
# Private uploads: source bytes plus 55000 reserved parse bytes per live file.
NEXUSPILOT_USER_FILE_QUOTA_BYTES=524288000
# Maximum 500; failed uploads retain quota until explicit or scheduled cleanup.
NEXUSPILOT_USER_FILE_COUNT_LIMIT=500
# PDF/Office executor socket. Leave unset until its image and checks pass.
# API connects to this socket only; do not mount the Docker socket into the API.
# Local alternative: make file-runtime-run, then make api-run-with-files (same FILE_RUNTIME_SOCKET).
# These targets do not change this file; ordinary make api-run still requires the setting below.
# NEXUSPILOT_FILE_RUNTIME_SOCKET=/run/nexuspilot-file-runtime/executor.sock
# Python is opt-in per native Nexus user. Apps and quick replies cannot execute it.
# Run deployments/task-runtime/serve_python.py separately; API needs only this private socket.
# NEXUSPILOT_PYTHON_RUNTIME_SOCKET=/absolute/private/python-runtime/python.sock
NEXUSPILOT_PYTHON_EXECUTION_USER_IDS=[]
# Task-local draft -> sample validation -> registration -> call; still requires Python owner grant.
NEXUSPILOT_DYNAMIC_PYTHON_ENABLED=false
NEXUSPILOT_MODEL_MAX_RETRIES=2
NEXUSPILOT_MODEL_RETRY_BACKOFF_SECONDS=0.1
NEXUSPILOT_MODEL_PRICING_JSON={}

# Provider Base URLs are stored in llm_provider_endpoints and loaded at API startup.
# Secrets remain here. A Provider registers only when an enabled database endpoint exists
# and its required API key is configured. Migration 20260831_0019 seeds DeepSeek's URL.
NEXUSPILOT_OPENAI_API_KEY=
NEXUSPILOT_OPENAI_MODELS=
NEXUSPILOT_DEEPSEEK_API_KEY=
NEXUSPILOT_DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
# Independent OpenCode credential; Base URL lives in llm_provider_endpoints.
NEXUSPILOT_OPENCODE_API_KEY=
NEXUSPILOT_OPENCODE_MODELS=deepseek-v4.1-flash
NEXUSPILOT_ANTHROPIC_API_KEY=
NEXUSPILOT_ANTHROPIC_MODELS=
NEXUSPILOT_GEMINI_API_KEY=
NEXUSPILOT_GEMINI_MODELS=

# Generic OpenAI Chat Completions compatible credentials and model allowlist.
# Its Base URL also belongs in llm_provider_endpoints under provider=openai_compatible.
NEXUSPILOT_OPENAI_COMPATIBLE_API_KEY=
NEXUSPILOT_OPENAI_COMPATIBLE_MODELS=

# Strata Chat Completions; configure https://mithfusion.site/v1 in llm_provider_endpoints.
NEXUSPILOT_STRATA_API_KEY=
NEXUSPILOT_STRATA_MODELS=

# Optional explicit project snapshot export. Create this private absolute directory first.
# No symlink components; the API process must own/write it. Empty/unset disables local export.
# MinIO project copies and downloads work without local export; no automatic cleanup is enabled.
# NEXUSPILOT_PROJECT_WORKSPACE_ROOT=/srv/nexuspilot/project-workspaces
