# Recreate socket clients after host runtime directories are created, including at boot.
# Restart this unit after explicitly restarting either host executor.
[Unit]
Description=NexusPilot API and independent Worker socket clients
After=docker.service nexuspilot-file-runtime.service nexuspilot-python-runtime.service
Requires=docker.service nexuspilot-file-runtime.service nexuspilot-python-runtime.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nexuspilot/current
ExecStart=/usr/bin/docker compose --env-file /etc/nexuspilot/config/.env -f /opt/nexuspilot/current/deployments/compose/docker-compose.production.yml -f /opt/nexuspilot/current/deployments/compose/docker-compose.office.yml -f /opt/nexuspilot/current/deployments/compose/docker-compose.python.yml --profile worker up -d --no-deps --force-recreate --wait --wait-timeout 180 api worker
ExecStop=/usr/bin/docker compose --env-file /etc/nexuspilot/config/.env -f /opt/nexuspilot/current/deployments/compose/docker-compose.production.yml -f /opt/nexuspilot/current/deployments/compose/docker-compose.office.yml -f /opt/nexuspilot/current/deployments/compose/docker-compose.python.yml --profile worker stop -t 140 worker api
TimeoutStartSec=240
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
